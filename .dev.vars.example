# Local development only. Prefer npm run setup:dev for fresh random keys and dates.
PUBLIC_BASE_URL="http://localhost:8787"
POLL_ID="demo-local"
POLL_QUESTION="你支持邊個方案？"
POLL_OPTIONS_JSON='[{"id":"a","label":"方案 A"},{"id":"b","label":"方案 B"}]'
# Replace these with your intended ISO 8601 UTC start/end times.
POLL_OPENS_AT="REPLACE_WITH_START_TIME"
POLL_CLOSES_AT="REPLACE_WITH_END_TIME"
VOTE_SIGNING_KEY="replace-with-a-random-secret-at-least-32-characters"
TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"
ADMIN_EXPORT_KEY="replace-with-a-different-random-secret-at-least-32-characters"
ADMIN_DASHBOARD_KEY="replace-with-another-random-secret-at-least-32-characters"
