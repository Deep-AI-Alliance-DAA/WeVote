{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Local development template. Use setup:cloudflare for your own deployment.
  "name": "wevote-local-api",
  "workers_dev": false,
  "main": "src/worker.js",
  "compatibility_date": "2026-10-09",
  "vars": { "PUBLIC_BASE_URL": "http://localhost:8787" },
  "kv_namespaces": [
    { "binding": "EVENTS", "id": "00000000000000000000000000000000" }
  ],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 0.01 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "VOTE_SHARD", "class_name": "VoteShard" },
      { "name": "EVENT_COORDINATOR", "class_name": "EventCoordinator" },
      { "name": "ADMIN_DIRECTORY", "class_name": "AdminDirectory" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["VoteShard"] },
    { "tag": "v2", "new_sqlite_classes": ["EventCoordinator"] },
    { "tag": "v3", "new_sqlite_classes": ["AdminDirectory"] }
  ]
}
